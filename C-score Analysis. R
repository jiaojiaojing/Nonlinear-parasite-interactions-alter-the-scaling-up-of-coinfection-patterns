sim.func <- function(mite_load, type, seed) {
  
  set.seed(seed) #for reproducibility
  
   if(type=="env") {
    greg_load <- simulate(env.nbin.mod, n=1)
  }
  if(type=="lin") {
    greg_load <- simulate(lin.nbin.mod, n=1)
  }
  if(type=="quad") {
    quad.nbin.mod$fit$par[3] <- quad.nbin.mod$fit$par[3]/2
    quad.nbin.mod$fit$parfull[3] <- quad.nbin.mod$fit$parfull[3]/2
    greg_load <- simulate(quad.nbin.mod, n=1)
  }
  if(type=="quad_strong") {
    quad.nbin.mod$fit$par[3] <- quad.nbin.mod$fit$par[3]*2
    quad.nbin.mod$fit$parfull[3] <- quad.nbin.mod$fit$parfull[3]*2
    greg_load <- simulate(quad.nbin.mod, n=1)
  }
  return( data.frame(mite_load=mite_load, greg_load=greg_load, greg_Infected=as.numeric(greg_load>0), mite_Infected=as.numeric(mite_load>0)) )
  
}

