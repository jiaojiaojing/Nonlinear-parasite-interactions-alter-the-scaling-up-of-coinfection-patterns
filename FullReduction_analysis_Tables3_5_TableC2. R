# Full reduction: gregarine infection (0/1) vs. mite infection (0/1)
# Models fitted separately for each host species.
# Note: Month is excluded from BOTH candidate models here. Confirm against
# the model specification used for the published tables before replacing results.

library(tidyverse)
library(lubridate)
library(glmmTMB)
library(MuMIn)
library(performance)

# 1. Read and harmonize the two years
coi2017.dat <- read.csv("./Data/Coinfection_data_2017.csv")
env2017.dat <- read.csv("./Data/SummarizedData_2017.csv")
coi2017.dat <- left_join(coi2017.dat, env2017.dat, by = "Lake")
coi2017.dat$Year <- "2017"

coi2019.dat <- read.csv("./Data/Parasite_Data_2019.csv")
env2019.dat <- read.csv("./Data/SummarizedData_2019.csv")
coi2019.dat <- left_join(coi2019.dat, env2019.dat, by = "Lake")
coi2019.dat$Year <- "2019"

coi2017.dat <- coi2017.dat %>%
  rename(total_holes = Total_Holes, Gregarines = Total_gregarines)
coi2019.dat <- coi2019.dat %>%
  rename(Total_Mites = final_mite)

coi.dat <- bind_rows(coi2017.dat, coi2019.dat)
coi.dat$Date <- mdy(coi.dat$Date)
coi.dat$Month <- factor(month(coi.dat$Date))
coi.dat <- coi.dat %>% mutate(Mites = total_holes + Total_Mites)
coi.dat$Species <- factor(coi.dat$Species)
coi.dat$Lake <- factor(coi.dat$Lake)
coi.dat$Year <- factor(coi.dat$Year)

# Infection indicators already exist in the CSVs; do not re-derive them.
stopifnot(all(na.omit(coi.dat$Greg_Infected) %in% c(0, 1)),
          all(na.omit(coi.dat$Mite_Infected) %in% c(0, 1)))

# 2. Fit comparable binomial GLMMs for each species
species_names <- levels(coi.dat$Species)
env.bin.mod <- setNames(vector("list", length(species_names)), species_names)
linenv.bin.mod <- setNames(vector("list", length(species_names)), species_names)
comparison <- vector("list", length(species_names))

for (sp in species_names) {
  curr.data <- coi.dat %>%
    filter(Species == sp) %>%
    select(Greg_Infected, Mite_Infected, Shoot.Countm2,
           Prey.DensityL, pH, Year, Lake) %>%
    drop_na() %>%
    droplevels()

  cat("\n====================\nSpecies:", sp,
      "\nComplete cases:", nrow(curr.data), "\n")
  print(table(curr.data$Greg_Infected))
  print(table(curr.data$Mite_Infected))

  if (nrow(curr.data) == 0L || length(unique(curr.data$Greg_Infected)) < 2L) {
    warning("Skipping ", sp, ": no complete cases or response has one class.")
    next
  }

  # Environmental-only model (no mite predictor)
  env.bin.mod[[sp]] <- glmmTMB(
    Greg_Infected ~ Shoot.Countm2 + Prey.DensityL + pH + Year + (1 | Lake),
    data = curr.data, family = binomial(link = "logit"), REML = FALSE
  )

  # Full reduction: BOTH parasite variables are binary.
  linenv.bin.mod[[sp]] <- glmmTMB(
    Greg_Infected ~ Mite_Infected + Shoot.Countm2 + Prey.DensityL +
      pH + Year + (1 | Lake),
    data = curr.data, family = binomial(link = "logit"), REML = FALSE
  )

  # Compare models on identical complete-case observations.
  aicc <- c(Environmental = MuMIn::AICc(env.bin.mod[[sp]]),
            Mite_presence = MuMIn::AICc(linenv.bin.mod[[sp]]))
  comparison[[match(sp, species_names)]] <- data.frame(
    Species = sp, Model = names(aicc), AICc = as.numeric(aicc),
    Delta_AICc = as.numeric(aicc - min(aicc)), N = nrow(curr.data)
  )
  print(comparison[[match(sp, species_names)]])

  cat("\nEnvironmental model summary:\n")
  print(summary(env.bin.mod[[sp]]))
  cat("\nMite presence model summary:\n")
  print(summary(linenv.bin.mod[[sp]]))

  cat("\nEnvironmental model R2 / ICC:\n")
  print(performance::r2(env.bin.mod[[sp]]))
  print(performance::icc(env.bin.mod[[sp]]))
  cat("\nMite presence model R2 / ICC:\n")
  print(performance::r2(linenv.bin.mod[[sp]]))
  print(performance::icc(linenv.bin.mod[[sp]]))
  cat("\nCollinearity (mite presence model):\n")
  print(performance::check_collinearity(linenv.bin.mod[[sp]]))
}

# 3. AICc comparison across species
comparison <- Filter(Negate(is.null), comparison)
if (length(comparison) > 0L) {
  comparison.table <- bind_rows(comparison)
  print(comparison.table)
  # Uncomment to save a separate table:
  # write.csv(comparison.table, "./FullReduction_AICc_comparison.csv", row.names = FALSE)
}

